# ========================================================
# CONFIGURACIÓN DE BASE DE DATOS TURSO (LIBSQL)
# ========================================================
# Copia este archivo como '.env' y reemplaza con tus credenciales de Turso:
#
# 1. URL de tu base de datos Turso:
TURSO_DATABASE_URL=libsql://historia-divertida-tu-usuario.turso.io

# 2. Token de autenticación de Turso:
TURSO_AUTH_TOKEN=tu_token_secreto_de_turso_aqui
